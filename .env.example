# Feltrim Agents Base - Environment Template
# Copie para .env e preencha. NUNCA commitar .env.

# LLM providers
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
GROQ_API_KEY=

# LM Studio (local inference - opcional)
# NOTA: Claude Code envia ~23k tokens de system prompt. Minimo: 32768.
LMSTUDIO_BASE_URL=http://127.0.0.1:1234
LMSTUDIO_DEFAULT_MODEL=qwen3-8b
LMSTUDIO_CONTEXT_LENGTH=32768

# Database (opcional - apenas se usar Supabase)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=

# Integracoes opcionais
OPENCLAW_PORT=3100
N8N_HOST=
N8N_PORT=5678

# Telegram / WhatsApp (opcional)
TELEGRAM_BOT_TOKEN=
WHATSAPP_API_KEY=

# Observabilidade (opcional)
LOG_LEVEL=info
